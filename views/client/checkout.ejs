<div class="mb-8">
  <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Thanh Toán Đơn Hàng</h1>
  <p class="text-xs text-slate-500 mt-1">Hoàn tất thông tin giao nhận để chúng tôi đóng gói và gửi hàng tới bạn</p>
</div>

<form action="/checkout" method="POST">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start mb-16">
    
    <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN (2 CỘT) -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- 1. THÔNG TIN KHÁCH HÀNG & NHẬN HÀNG -->
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
        <h2 class="text-base font-black text-slate-900 tracking-tight flex items-center gap-2.5 mb-5 pb-3 border-b border-slate-100">
          <i class="fa-solid fa-location-dot text-indigo-600"></i>
          <span>Địa Chỉ & Thông Tin Nhận Hàng</span>
        </h2>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="customer_name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Họ và tên người nhận *</label>
              <input 
                type="text" 
                id="customer_name" 
                name="customer_name" 
                required 
                value="<%= user ? user.fullname : '' %>"
                placeholder="Nguyễn Văn A" 
                class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 outline-none transition"
              >
            </div>

            <div>
              <label for="customer_phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Số điện thoại liên hệ *</label>
              <input 
                type="tel" 
                id="customer_phone" 
                name="customer_phone" 
                required 
                value="<%= user ? user.phone : '' %>"
                placeholder="0987654321" 
                class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 outline-none transition"
              >
            </div>
          </div>

          <div>
            <label for="shipping_address" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Địa chỉ giao hàng chi tiết *</label>
            <input 
              type="text" 
              id="shipping_address" 
              name="shipping_address" 
              required 
              value="<%= user ? (user.address || '') : '' %>"
              placeholder="Số nhà, Tên đường, Phường/Xã, Quận/Huyện, Tỉnh/TP" 
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 outline-none transition"
            >
          </div>

          <div>
            <label for="note" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Ghi chú giao hàng (Tùy chọn)</label>
            <textarea 
              id="note" 
              name="note" 
              rows="2" 
              placeholder="Ví dụ: Giao giờ hành chính, gọi điện trước khi tới..." 
              class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 outline-none transition resize-none"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- 2. PHƯƠNG THỨC THANH TOÁN -->
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
        <h2 class="text-base font-black text-slate-900 tracking-tight flex items-center gap-2.5 mb-5 pb-3 border-b border-slate-100">
          <i class="fa-solid fa-credit-card text-indigo-600"></i>
          <span>Phương Thức Thanh Toán</span>
        </h2>

        <div class="space-y-3">
          <!-- Option COD -->
          <label class="flex items-start gap-4 p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/50 cursor-pointer transition">
            <input type="radio" name="payment_method" value="cod" checked class="mt-1 text-indigo-600 focus:ring-indigo-500">
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-sm text-slate-900">Thanh toán khi nhận hàng (COD)</span>
                <i class="fa-solid fa-money-bill-wave text-emerald-600 text-lg"></i>
              </div>
              <p class="text-xs text-slate-500 mt-1">
                Bạn nhận kiện hàng, kiểm tra tem niêm phong và thanh toán tiền mặt trực tiếp cho nhân viên giao hàng bưu tá.
              </p>
            </div>
          </label>

          <!-- Option Banking -->
          <label class="flex items-start gap-4 p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 cursor-pointer transition">
            <input type="radio" name="payment_method" value="banking" class="mt-1 text-indigo-600 focus:ring-indigo-500">
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-sm text-slate-900">Chuyển khoản Ngân hàng (VietQR)</span>
                <i class="fa-solid fa-qrcode text-indigo-600 text-lg"></i>
              </div>
              <p class="text-xs text-slate-500 mt-1">
                Quét mã QR qua ứng dụng ngân hàng hoặc Mobile Banking 24/7. Đơn hàng được xác nhận nhanh chóng.
              </p>
              <div class="mt-2 p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs font-mono text-slate-600 space-y-1">
                <p>Ngân hàng: <b>MB Bank (Quân Đội)</b> - STK: <b>999988889999</b></p>
                <p>Chủ tài khoản: <b>CONG TY QZSTORE VIET NAM</b></p>
              </div>
            </div>
          </label>
        </div>
      </div>

    </div>

    <!-- CỘT PHẢI: CHI TIẾT ĐƠN HÀNG & NÚT XÁC NHẬN (1 CỘT) -->
    <div class="lg:col-span-1 bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 sticky top-24 space-y-6">
      <h2 class="text-base font-black text-slate-900 tracking-tight border-b border-slate-100 pb-4 flex items-center justify-between">
        <span>Đơn Hàng Của Bạn</span>
        <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">
          <%= checkoutItems.length %> món
        </span>
      </h2>

      <!-- Danh sách tóm tắt mặt hàng -->
      <div class="max-h-60 overflow-y-auto space-y-3 pr-1 divide-y divide-slate-100">
        <% checkoutItems.forEach(item => { %>
          <div class="pt-3 first:pt-0 flex items-center gap-3">
            <img src="<%= item.image %>" alt="<%= item.product_name %>" class="w-12 h-12 rounded-xl object-cover bg-slate-100 flex-shrink-0">
            <div class="min-w-0 flex-1">
              <p class="font-bold text-xs text-slate-800 truncate"><%= item.product_name %></p>
              <p class="text-[11px] text-slate-400"><%= item.variant_name %> x <%= item.quantity %></p>
            </div>
            <span class="text-xs font-bold text-slate-800 flex-shrink-0">
              <%= formatVND(item.lineTotal) %>
            </span>
          </div>
        <% }) %>
      </div>

      <!-- Tạm tính và phí ship -->
      <div class="space-y-3 text-xs border-t border-slate-100 pt-4">
        <div class="flex justify-between text-slate-600">
          <span>Tiền hàng tạm tính</span>
          <span class="font-bold text-slate-800"><%= formatVND(subtotal) %></span>
        </div>

        <div class="flex justify-between text-slate-600">
          <span>Phí giao hàng</span>
          <% if (shippingFee === 0) { %>
            <span class="font-bold text-emerald-600">Miễn phí ship</span>
          <% } else { %>
            <span class="font-bold text-slate-800"><%= formatVND(shippingFee) %></span>
          <% } %>
        </div>

        <div class="pt-3 border-t border-slate-100 flex justify-between items-baseline">
          <span class="text-sm font-black text-slate-900">Tổng thanh toán</span>
          <span class="text-2xl font-black text-indigo-600 tracking-tight">
            <%= formatVND(finalTotal) %>
          </span>
        </div>
      </div>

      <!-- Nút đặt hàng -->
      <button 
        type="submit" 
        class="w-full py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-xl shadow-indigo-200 hover:shadow-indigo-300 transition duration-200 flex items-center justify-center gap-2"
      >
        <i class="fa-solid fa-lock text-xs text-amber-300"></i>
        <span>Xác Nhận Đặt Hàng Ngay</span>
      </button>

      <p class="text-[11px] text-center text-slate-400 leading-normal">
        Bằng cách đặt hàng, bạn đồng ý với các điều khoản bảo mật và chính sách bảo hành của QZStore.
      </p>
    </div>

  </div>
</form>
