<!-- 1. HERO BANNER SECTION -->
<div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 text-white shadow-2xl mb-12 border border-slate-800">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(99,102,241,0.25),transparent_50%)]"></div>
  <div class="relative max-w-6xl mx-auto px-6 py-16 sm:py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-bold uppercase tracking-wider">
        <i class="fa-solid fa-bolt text-amber-400"></i> Công nghệ GaN & Âm thanh Hi-Res
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.15]">
        Phụ Kiện Điện Tử <br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-300 to-amber-300">
          Chính Hãng 100%
        </span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-lg">
        Nâng tầm trải nghiệm công nghệ với tai nghe chống ồn, củ sạc nhanh GaN, cáp bọc dù siêu bền và pin dự phòng công suất cao. Bảo hành điện tử chính hãng lên tới 24 tháng.
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="/products" class="px-7 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-xl shadow-indigo-600/40 hover:shadow-indigo-600/60 transition-all flex items-center gap-2.5">
          <span>Khám phá ngay</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        <a href="/warranty" class="px-7 py-3.5 rounded-2xl bg-slate-800/80 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold text-sm transition-all flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-emerald-400"></i>
          <span>Tra cứu bảo hành</span>
        </a>
      </div>
    </div>

    <div class="relative lg:h-96 flex items-center justify-center">
      <div class="w-full max-w-md relative">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-indigo-500 to-amber-500 opacity-30 blur-2xl"></div>
        <img 
          src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80" 
          alt="Sony WH-1000XM5 Premium Headphone" 
          class="relative rounded-3xl object-cover w-full h-80 sm:h-96 shadow-2xl border border-slate-700/50 transform hover:scale-[1.02] transition duration-500"
        >
        <div class="absolute -bottom-4 -left-4 bg-slate-900/90 backdrop-blur-md border border-slate-700 p-3.5 rounded-2xl shadow-xl flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-lg">
            <i class="fa-solid fa-star"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-white">Sony WH-1000XM5</p>
            <p class="text-[11px] text-slate-400">Chống ồn đỉnh cao ANC</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- 2. VALUE PROPOSITIONS -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-16">
  <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-start gap-4 hover:shadow-md transition">
    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl flex-shrink-0">
      <i class="fa-solid fa-certificate"></i>
    </div>
    <div>
      <h3 class="font-bold text-sm text-slate-900">100% Chính Hãng</h3>
      <p class="text-xs text-slate-500 mt-0.5">Cam kết nguồn gốc minh bạch từ Anker, Sony, Apple...</p>
    </div>
  </div>

  <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-start gap-4 hover:shadow-md transition">
    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0">
      <i class="fa-solid fa-shield-heart"></i>
    </div>
    <div>
      <h3 class="font-bold text-sm text-slate-900">Bảo Hành Điện Tử</h3>
      <p class="text-xs text-slate-500 mt-0.5">Tra cứu IMEI/Serial trực tuyến, đổi mới 30 ngày</p>
    </div>
  </div>

  <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-start gap-4 hover:shadow-md transition">
    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl flex-shrink-0">
      <i class="fa-solid fa-truck-fast"></i>
    </div>
    <div>
      <h3 class="font-bold text-sm text-slate-900">Giao Hàng Siêu Tốc</h3>
      <p class="text-xs text-slate-500 mt-0.5">Miễn phí ship từ 500k, đóng gói chống sốc an toàn</p>
    </div>
  </div>

  <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-start gap-4 hover:shadow-md transition">
    <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl flex-shrink-0">
      <i class="fa-solid fa-headset"></i>
    </div>
    <div>
      <h3 class="font-bold text-sm text-slate-900">Hỗ Trợ Kỹ Thuật 24/7</h3>
      <p class="text-xs text-slate-500 mt-0.5">Tư vấn chuẩn công suất sạc & chuẩn kết nối</p>
    </div>
  </div>
</div>

<!-- 3. FEATURED CATEGORIES -->
<div class="mb-16">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Khám phá theo danh mục</span>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-0.5">Danh Mục Phụ Kiện Nổi Bật</h2>
    </div>
    <a href="/products" class="text-xs sm:text-sm font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
      <span>Xem tất cả</span>
      <i class="fa-solid fa-chevron-right text-xs"></i>
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
    <% categories.forEach(cat => { %>
      <a href="/products?category=<%= cat.slug %>" class="group p-6 rounded-2xl bg-white border border-slate-200/80 hover:border-indigo-500 hover:shadow-xl hover:shadow-indigo-500/10 text-center transition-all duration-300 flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white flex items-center justify-center text-2xl mb-4 transition duration-300">
          <i class="fa-solid <%= cat.icon || 'fa-box' %>"></i>
        </div>
        <h3 class="font-bold text-sm text-slate-800 group-hover:text-indigo-600 transition mb-1">
          <%= cat.name %>
        </h3>
        <p class="text-[11px] text-slate-400 font-medium">
          <%= cat.product_count || 0 %> sản phẩm
        </p>
      </a>
    <% }) %>
  </div>
</div>

<!-- 4. LATEST PRODUCTS GRID -->
<div class="mb-16">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Sản phẩm chất lượng</span>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-0.5">Sản Phẩm Mới & Bán Chạy Nhất</h2>
    </div>
    <a href="/products" class="text-xs sm:text-sm font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
      <span>Xem toàn bộ kho hàng</span>
      <i class="fa-solid fa-chevron-right text-xs"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% latestProducts.forEach(prod => { %>
      <div class="product-card group bg-white rounded-2xl border border-slate-200/80 hover:border-indigo-400 hover:shadow-xl hover:shadow-indigo-500/10 transition duration-300 flex flex-col overflow-hidden">
        
        <!-- Image & Badges -->
        <div class="relative bg-slate-100 product-card-img-wrapper overflow-hidden h-56 flex items-center justify-center">
          <img 
            src="<%= prod.thumbnail %>" 
            alt="<%= prod.name %>" 
            class="w-full h-full object-cover"
            loading="lazy"
          >
          <div class="absolute top-3 left-3 flex flex-col gap-1.5">
            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-indigo-600 text-white shadow-sm">
              <%= prod.brand_name %>
            </span>
          </div>

          <% if (prod.warranty_months) { %>
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] font-semibold text-emerald-700 border border-emerald-200">
              <i class="fa-solid fa-shield-check mr-1"></i>BH <%= prod.warranty_months %> tháng
            </div>
          <% } %>
        </div>

        <!-- Details -->
        <div class="p-5 flex flex-col flex-1">
          <div class="text-[11px] text-slate-400 uppercase font-semibold mb-1">
            <%= prod.category_name %>
          </div>

          <a href="/product/<%= prod.slug %>" class="font-bold text-sm text-slate-800 hover:text-indigo-600 line-clamp-2 transition mb-3 flex-1" title="<%= prod.name %>">
            <%= prod.name %>
          </a>

          <!-- Price & Stock -->
          <div class="pt-3 border-t border-slate-100 flex items-end justify-between">
            <div>
              <p class="text-[10px] text-slate-400 uppercase font-semibold">Giá từ</p>
              <p class="text-base font-black text-indigo-600">
                <%= formatVND(prod.min_price || 0) %>
              </p>
            </div>

            <a href="/product/<%= prod.slug %>" class="w-9 h-9 rounded-xl bg-slate-100 group-hover:bg-indigo-600 text-slate-700 group-hover:text-white flex items-center justify-center transition" title="Xem chi tiết">
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>

        </div>

      </div>
    <% }) %>
  </div>
</div>

<!-- 5. FEATURED BRANDS SECTION -->
<div class="p-8 rounded-3xl bg-white border border-slate-200/80 mb-12">
  <div class="text-center max-w-xl mx-auto mb-8">
    <h3 class="text-lg font-bold text-slate-800">Thương Hiệu Phụ Kiện Hàng Đầu Hợp Tác Chính Hãng</h3>
    <p class="text-xs text-slate-500 mt-1">Sản phẩm đầy đủ hóa đơn VAT, chứng nhận hợp chuẩn hợp quy</p>
  </div>
  
  <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 opacity-80 grayscale hover:grayscale-0 transition duration-300">
    <% brands.forEach(b => { %>
      <a href="/products?brand=<%= b.slug %>" class="hover:scale-110 transition duration-200" title="<%= b.name %>">
        <% if (b.logo) { %>
          <img src="<%= b.logo %>" alt="<%= b.name %>" class="h-8 max-w-[100px] object-contain">
        <% } else { %>
          <span class="text-lg font-black text-slate-700"><%= b.name %></span>
        <% } %>
      </a>
    <% }) %>
  </div>
</div>
