<% if (flashSuccess) { %>
  <div class="flash-alert-box mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm animate-fade-in" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div>
        <p class="font-medium text-sm"><%= flashSuccess %></p>
      </div>
    </div>
    <button type="button" onclick="this.closest('.flash-alert-box').remove()" class="text-emerald-500 hover:text-emerald-700 p-1">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>

<% if (flashError) { %>
  <div class="flash-alert-box mb-6 bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm animate-fade-in" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <p class="font-medium text-sm"><%= flashError %></p>
      </div>
    </div>
    <button type="button" onclick="this.closest('.flash-alert-box').remove()" class="text-rose-500 hover:text-rose-700 p-1">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>
