<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
  <div class="max-w-md w-full text-center bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
    <div class="w-20 h-20 mx-auto mb-6 rounded-2xl flex items-center justify-center text-3xl <%= statusCode === 403 ? 'bg-amber-100 text-amber-600' : statusCode === 404 ? 'bg-indigo-100 text-indigo-600' : 'bg-rose-100 text-rose-600' %>">
      <% if (statusCode === 403) { %>
        <i class="fa-solid fa-lock"></i>
      <% } else if (statusCode === 404) { %>
        <i class="fa-solid fa-compass"></i>
      <% } else { %>
        <i class="fa-solid fa-triangle-exclamation"></i>
      <% } %>
    </div>

    <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight mb-2"><%= statusCode %></h1>
    <h2 class="text-xl font-bold text-slate-700 mb-4"><%= title %></h2>
    <p class="text-slate-600 text-sm mb-6 leading-relaxed"><%= message %></p>

    <% if (typeof details !== 'undefined' && details) { %>
      <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-500 mb-6 text-left break-all">
        <%= details %>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition-all shadow-md shadow-indigo-200">
        <i class="fa-solid fa-house mr-2"></i> Trang chủ
      </a>
      <% if (statusCode === 403 && currentUser) { %>
        <a href="/auth/logout" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-sm transition-all">
          <i class="fa-solid fa-right-from-bracket mr-2"></i> Đăng xuất & Đổi tài khoản
        </a>
      <% } else { %>
        <button onclick="history.back()" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-sm transition-all">
          <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại
        </button>
      <% } %>
    </div>
  </div>
</div>
